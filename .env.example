# Urban Flood Nowcasting System - Environment Variables
# Copy to .env for local deployment

# Database Configuration (PostgreSQL + PostGIS or SQLite fallback)
# For local SQLite: sqlite:///./flood_nowcasting.db
# For Docker PostGIS: postgresql://flood_user:flood_secure_password_change_me@localhost:5432/urban_flood_db
DATABASE_URL=sqlite:///./flood_nowcasting.db

# Redis Cache (Optional for single-instance local runs)
REDIS_URL=redis://localhost:6379/0

# External APIs
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Geospatial Default Configuration
DEFAULT_STUDY_AREA_ID=lpu_main_campus
DEFAULT_LAT=31.2533
DEFAULT_LON=75.7033
DEFAULT_RADIUS_KM=3.5

# Security (Change in Production!)
SECRET_KEY=sih-2026-lpu-flood-nowcasting-production-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
